# Copy to .env and adjust values for your environment
DATABASE_URL="postgresql://ticketing_user:ticketing_pass@localhost:5432/enginedesk?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=5000
NODE_ENV="development"

# Upload limits (multer)
MAX_FILE_SIZE=5242880
UPLOAD_DIR="uploads"

# Ticket attachments: persistent storage in a PRIVATE Supabase Storage bucket.
# Required on Render (its disk is wiped on every deploy). Leave empty locally
# to store files in UPLOAD_DIR instead. The service-role key is server-only:
# never expose it to the frontend or commit it.
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="ticket-attachments"

# Frontend base (used for CORS / absolute URLs if needed)
CLIENT_URL="http://localhost:8080"

# Optional dedicated operator bootstrap. Set both values before running seed.js.
# Use a unique password of 12+ characters (maximum 72 UTF-8 bytes).
# OPERATOR_EMAIL="operator@example.com"
# OPERATOR_PASSWORD="replace-with-a-unique-secure-password"
# OPERATOR_NAME="Platform Operator"
# OPERATOR_COMPANY="EngineDesk Operations"
